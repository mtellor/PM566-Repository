fun1 <- function(n = 100, k = 4, lambda = 4) {
x <- NULL
for (i in 1:n){
x <- rbind(x, rpois(k, lambda))
}
return(x)
}
fun1alt <- function(n = 100, k = 4, lambda = 4) {
matrix(rpois(n * k, lambda), nrow = n, ncol = k)
}
install.packages("parallel")
# Set-up ----
library(parallel)
fun1 <- function(n = 100, k = 4, lambda = 4) {
x <- NULL
for (i in 1:n){
x <- rbind(x, rpois(k, lambda))
}
return(x)
}
fun1alt <- function(n = 100, k = 4, lambda = 4) {
matrix(rpois(n * k, lambda), nrow = n, ncol = k)
}
identical(dim(fun1()), dim(fun1alt()))
set.seed(123)
dim_check <- all(dim(fun1()) == dim(fun1alt()))
dist_check <- abs(mean(fun1()) - mean(fun1alt())) < 0.1
library(microbenchmark)
install.packages("microbenchmark")
# Benchmarking
library(microbenchmark)
# Benchmarking
microbenchmark::microbenchmark(
fun1(),
fun1alt()
)
microbenchmark::microbenchmark(
fun1(),
fun1alt()
)
set.seed(1234)
x <- matrix(rnorm(1e4), nrow=10)
# Find each column's max value
fun2 <- function(x) {
apply(x, 2, max)
}
fun2 <- function(x) {
apply(x, 2, max)
}
fun2alt <- function(x) {
vapply(seq_len(ncol(x)), function(i) max(x[, i]), numeric(1))
}
# Output check
output_check <- all(fun2(x) == fun2alt(x))
# Benchmarking
microbenchmark::microbenchmark(
fun2(x),
fun2alt(x)
)
my_boot <- function(dat, stat, R, ncpus = 1L) {
# Generate bootstrap indices
n <- nrow(dat)
idx <- matrix(sample.int(n, n * R, TRUE), nrow = n, ncol = R)
# Set up parallel backend
cl <- makeCluster(ncpus)
clusterExport(cl, varlist = c("dat", "stat", "idx"), envir = environment())
# Parallel loop
ans <- parLapply(cl, seq_len(R), function(i) {
stat(dat[idx[, i], , drop = FALSE])
})
stopCluster(cl)
# Combine results
ans <- do.call(rbind, ans)
return(ans)
}
return(ans)
# Question 3 ----
my_boot <- function(dat, stat, R, ncpus = 1L) {
# Generate bootstrap indices
n <- nrow(dat)
idx <- matrix(sample.int(n, n * R, TRUE), nrow = n, ncol = R)
# Set up parallel backend
cl <- makeCluster(ncpus)
clusterExport(cl, varlist = c("dat", "stat", "idx"), envir = environment())
# Parallel loop
ans <- parLapply(cl, seq_len(R), function(i) {
stat(dat[idx[, i], , drop = FALSE])
})
stopCluster(cl)
# Combine results
ans <- do.call(rbind, ans)
return(ans)
}
my_stat <- function(d) coef(lm(y ~ x, data = d))
# Data simulation
set.seed(1)
n <- 500; R <- 1e4
x <- cbind(rnorm(n)); y <- x * 5 + rnorm(n)
# Parametric model
ans0 <- confint(lm(y ~ x))
# Bootstrap model (parallel)
ans1 <- my_boot(dat = data.frame(x, y), stat = my_stat, R = R, ncpus = 2L)
# Compare confidence intervals
boot_ci <- t(apply(ans1, 2, quantile, c(.025, .975)))
# Output check
accuracy_check <- all(abs(boot_ci - ans0) < 0.01)
# Question 3.2 (continued) ----
# Bootstrap of an OLS
my_stat <- function(d) coef(lm(y ~ x, data=d))
# DATA SIM
set.seed(1)
n <- 500; R <- 1e4
x <- cbind(rnorm(n)); y <- x*5 + rnorm(n)
# Checking if we get something similar as lm
ans0 <- confint(lm(y~x))
ans1 <- my_boot(dat = data.frame(x, y), my_stat, R = R, ncpus = 2L)
# You should get something like this
t(apply(ans1, 2, quantile, c(.025,.975)))
##                   2.5%      97.5%
## (Intercept) -0.1372435 0.05074397
## x            4.8680977 5.04539763
ans0
ans0
t(apply(ans1, 2, quantile, c(.025,.975)))
ans0
# 3.3 ----
system.time(my_boot(dat = data.frame(x, y), my_stat, R = 4000, ncpus = 1L))
system.time(my_boot(dat = data.frame(x, y), my_stat, R = 4000, ncpus = 2L))
