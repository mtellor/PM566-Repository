# Example: read your cleaned CSV and make a simple comparison plot
library(dplyr)
library(ggplot2)
# replace "data.csv" with your file path
df <- read.csv("~/Library/CloudStorage/GoogleDrive-tellorin@usc.edu/.shortcut-targets-by-id/10yI1Vp2x44iBX7T-_NfWNeL7go8kwnUH/2. College - USC/1. Degree/1. Courses/Y4 Senior/Fall 2025/PM 566/PM566-Repository/Assignments/Final/data/data.csv")
hospitals <- c("PIH Health Whittier Hospital", "PIH Health Downey Hospital", "PIH Health Good Samaritan Hospital")
df3 <- df %>%
filter(FACILITY_NAME %in% hospitals) %>%
mutate(total_disp = disp_Routine + disp_Against_Medical_Advice + disp_Acute_Care +
disp_Psychiatric_Care + disp_SN_IC_Care + disp_Died +
disp_Hospice_Care + disp_Residential_Care + disp_Childrens_or_Cancer +
disp_Other + disp_Rehab + disp_Prison_Jail) %>%
mutate(ama_rate = disp_Against_Medical_Advice / total_disp,
routine_rate = disp_Routine / total_disp)
ggplot(df3, aes(x = FACILITY_NAME, y = ama_rate)) +
geom_col(fill = "dodgerblue3") +
labs(x = NULL, y = "AMA rate", title = "Against Medical Advice (AMA) rate by hospital") +
scale_y_continuous(labels = scales::percent_format()) +
theme_minimal(base_size = 13) +
theme(axis.text.x = element_text(angle = 20, hjust = 1))
View(df)
View(df3)
