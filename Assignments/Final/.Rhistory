mutate(across(where(is.numeric), ~ ifelse(is.na(.), 0, .)))
ed_clean <- ed %>%
mutate(across(where(is.numeric), ~ ifelse(is.na(.), 0, .))) %>%
mutate(across(where(is.character), ~ ifelse(is.na(.), "Unknown", .)))
