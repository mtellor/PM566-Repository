# Load packages
library(stringr)
library(knitr)
# Read and segment abstracts
abstracts <- readLines('~/Downloads/abstract-sars-cov-2-set.txt', warn = FALSE)
# Read and segment abstracts
abstracts <- readLines('~/Library/CloudStorage/GoogleDrive-tellorin@usc.edu/.shortcut-targets-by-id/10yI1Vp2x44iBX7T-_NfWNeL7go8kwnUH/2. College - USC/1. Degree/1. Courses/Y4 Senior/Fall 2025/PM 566/PM566-Repository/Lab/Lab 7/Lab 7/data/abstract-sars-cov-2-set.txt', warn = FALSE)
abstracts <- paste(abstracts, collapse = '\n')
abstracts <- unlist(strsplit(abstracts, split = '\n\n\n'))
# Extract journal name (first line after citation number)
journal <- str_extract(abstracts, "^[0-9]+\\.\\s[^\n]+")
# Extract article title (second block)
titles <- sapply(abstracts, function(x){
unlist(strsplit(x, split = "\n\n"))[2]
}, USE.NAMES = FALSE)
titles <- gsub("\n", " ", titles)
titles <- gsub(" +", " ", titles)
titles <- str_trim(titles)
# Extract authors (third block)
authors <- sapply(abstracts, function(x){
unlist(strsplit(x, split = "\n\n"))[3]
}, USE.NAMES = FALSE)
authors <- gsub("\n", " ", authors)
authors <- gsub("\\(\\d+\\)", "", authors)  # remove superscripts
authors <- gsub(" +", " ", authors)
authors <- str_trim(authors)
# Extract affiliations (between "Author information:" and next blank line)
affiliations <- str_extract(abstracts, "Author information:[\\s\\S]*?(?=\\n\\n|$)")
affiliations <- gsub("\n", " ", affiliations)
affiliations <- gsub(" +", " ", affiliations)
affiliations <- gsub("[,;\\.]\\s*$", "", affiliations)
affiliations <- str_trim(affiliations)
# Combine into tidy data frame
papers <- data.frame(
Journal = journal,
Title = titles,
Authors = authors,
Affiliations = affiliations,
stringsAsFactors = FALSE
)
# Print first 5 rows
kable(papers[1:5, ])
